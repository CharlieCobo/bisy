# Puerto del API
PORT=4000
# Ruta de la base de datos SQLite
DB_PATH=./server/data/bisy.db
# Moneda base para el patrimonio consolidado
BASE_CURRENCY=EUR

# --- Conexión bancaria (Enable Banking, PSD2) ---
# Crea una aplicación en https://enablebanking.com/cp/applications
ENABLE_BANKING_APP_ID=
# Ruta a la clave privada .pem que descargas al crear la aplicación
ENABLE_BANKING_KEY_PATH=./enablebanking.pem
# Debe coincidir con la URL de redirección registrada en la aplicación.
# Enable Banking exige https: esta página (GitHub Pages) reenvía a tu Bisy local.
ENABLE_BANKING_REDIRECT_URL=https://charliecobo.github.io/bisy/callback.html
